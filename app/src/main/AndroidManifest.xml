<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Link Wrapper"
        android:theme="@style/Theme.LinkWrapper"
        android:usesCleartextTraffic="false">

        <!-- Domovská obrazovka appky (spouští se z launcheru) -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Obrazovka, která zobrazí odkaz ve WebView -->
        <activity
            android:name=".WebViewActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <!--
              Konkrétní firemní doména. Uvedená explicitně, aby se aplikace
              nabídla i na Androidu 12+, kde se obecné http/https filtry
              bez ověření domény často přeskakují.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="psst.tudc.cz" />
                <data android:scheme="http" android:host="psst.tudc.cz" />
            </intent-filter>

            <!-- Ostatní adresy: aplikace se nabídne v "Otevřít pomocí". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!--
              Sdílení odkazu. Náhradní cesta, když Outlook otevírání
              odkazů nepředá systému - uživatel dá Sdílet a vybere aplikaci.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Historie otevřených odkazů -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

    </application>
</manifest>
