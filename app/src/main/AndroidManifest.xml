<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LinkWrapper"
        android:usesCleartextTraffic="false">

        <!--
          Hlavní obrazovka: rovnou WebView s výchozí PSST adresou.
          Nahoře jen toolbar s nabídkou ⋮ (zadat adresu, přenačíst…).
        -->
        <activity
            android:name=".WebViewActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Explicitní firemní hostitelé — Android 12+ jinak obecné
              http/https filtry často přeskočí.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="psst.tudc.cz" />
                <data android:scheme="http" android:host="psst.tudc.cz" />
                <data android:scheme="https" android:host="test.psst.tudc.cz" />
                <data android:scheme="http" android:host="test.psst.tudc.cz" />
            </intent-filter>

            <!-- Ostatní adresy: nabídka v „Otevřít pomocí“. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!--
              Sdílení odkazu. Náhradní cesta, když Outlook otevírání
              odkazů nepředá systému — uživatel dá Sdílet a vybere aplikaci.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Domovská / nastavení — už se nespouští z launcheru. -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

    </application>
</manifest>
