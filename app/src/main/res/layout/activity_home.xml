<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textColor="@color/ink"
            android:letterSpacing="-0.03"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Interní stránky přes firemní certifikát."
            android:textSize="15sp"
            android:textColor="@color/ink_soft"
            android:lineSpacingMultiplier="1.35" />

        <!-- Stav: je aplikace nastavená jako výchozí pro odkazy? -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_status"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_settings_alert"
                app:tint="@color/warn"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nenastaveno pro odkazy"
                    android:textSize="14sp"
                    android:textColor="@color/ink"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/statusBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Odkazy z Outlooku zatím míří jinam"
                    android:textSize="13sp"
                    android:textColor="@color/ink_soft"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <ImageView
                android:id="@+id/statusChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron"
                app:tint="@color/ink_faint"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="12dp"
            android:text="Otevřít adresu"
            android:textSize="13sp"
            android:textColor="@color/ink_faint"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/urlLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="psst.tudc.cz/…"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:startIconDrawable="@drawable/ic_link"
            app:startIconTint="@color/ink_faint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:maxLines="1"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Otevřít"
            android:textSize="15sp"
            android:letterSpacing="0"
            android:textAllCaps="false"
            app:cornerRadius="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="36dp"
            android:background="@color/line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/certButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ověřování certifikátů"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:gravity="center_vertical|start"
            android:paddingHorizontal="12dp"
            app:icon="@drawable/ic_shield"
            app:iconGravity="start"
            app:iconPadding="16dp"
            app:iconTint="@color/ink_soft"
            android:textColor="@color/ink" />

    </LinearLayout>
</ScrollView>
